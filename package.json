{
  "name": "steady-move",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc --pretty false --strict --target ES2020 --module commonjs --moduleResolution node --rootDir src --outDir .test-build src/types.ts src/data/exercises.ts src/lib/planner.ts src/lib/progress.ts && node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
