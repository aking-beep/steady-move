{
  "name": "steady-move",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint app src",
    "doctor": "expo-doctor",
    "pretest": "tsc --pretty false --strict --noUncheckedIndexedAccess false --esModuleInterop --target ES2020 --module commonjs --moduleResolution node --skipLibCheck --rootDir src --outDir .test-build src/types/index.ts src/data/exercises.ts src/data/explore.ts src/data/places.ts src/engine/duration.ts src/engine/runwalk.ts src/engine/planner.ts src/lib/progress.ts src/lib/date.ts src/lib/demo.ts src/lib/sessions.ts src/lib/places.ts src/lib/storage.ts src/lib/vision.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.59.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.16",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "expo-font": "~57.0.4"
  }
}
